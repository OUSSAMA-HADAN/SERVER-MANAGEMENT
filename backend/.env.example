# ── Core ─────────────────────────────────────────────────────────────
# Random, >= 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without a strong value.
SESSION_SECRET=

# Name shown in push notifications and the 2FA app
SERVER_NAME=my-server

# Port + bind address. Bind to the address cloudflared connects through so the
# panel can't be reached directly from the LAN (0.0.0.0 = every interface).
PORT=3000
BIND_HOST=0.0.0.0

# How long a login lasts (hours)
SESSION_HOURS=12

# Extra allowed browser origins (comma separated). Same-host is always allowed.
# ALLOWED_ORIGINS=https://panel.example.com

# ── Cloudflare Turnstile (bot protection on the login form) ──────────
# Dashboard → Turnstile → Add widget → hostname = your panel domain
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cloudflare Access (Zero Trust login in front of the whole site) ──
# Zero Trust → Access → Applications → your app → "Application Audience (AUD) Tag"
# When set, every request without a valid Access token is rejected (403),
# including anyone who bypasses Cloudflare and hits the origin directly.
# e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: path used for project disk stats (defaults to backend folder)
# PROJECT_DISK_PATH=/media/srv/741C94C748D7C32A
