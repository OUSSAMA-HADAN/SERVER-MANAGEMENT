# ── Core ─────────────────────────────────────────────────────────────
# Random, >= 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without a strong value.
SESSION_SECRET=

# Name shown in push notifications and the 2FA app
SERVER_NAME=my-server

# Port + bind addresses. Comma-separated; one listener per address. List only
# what you need so the panel can't be reached from the LAN, e.g.
#   127.0.0.1,172.17.0.1,100.x.y.z   (localhost, Docker bridge cloudflared dials, Tailscale)
# An address that isn't up yet is retried every 10 s; the others keep serving.
# 0.0.0.0 = every interface.
PORT=3000
BIND_HOST=0.0.0.0

# How long a login lasts (hours)
SESSION_HOURS=12

# Extra allowed browser origins (comma separated). Same-host is always allowed.
# ALLOWED_ORIGINS=https://panel.example.com

# ── Cloudflare Turnstile (bot protection on the login form) ──────────
# Dashboard → Turnstile → Add widget → hostname = your panel domain
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cloudflare Access (Zero Trust login in front of the whole site) ──
# Zero Trust → Access → Applications → your app → "Application Audience (AUD) Tag"
# When set, every request without a valid Access token is rejected (403),
# including anyone who bypasses Cloudflare and hits the origin directly.
# Tokens are checked for signature (keys from <team>/cdn-cgi/access/certs,
# cached), issuer, audience and expiry; if the keys can't be fetched, tunnel
# requests are refused.
# e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional: also require the token's email to be one of these (comma separated)
# ACCESS_ALLOWED_EMAILS=you@example.com
# Listener addresses that skip the Access check because traffic there never
# passes Cloudflare (e.g. Tailscale, localhost). App login + 2FA still apply.
# Decided by the address the connection arrived on, not by headers.
# ACCESS_EXEMPT_LOCAL=127.0.0.1,100.x.y.z

# Optional: path used for project disk stats (defaults to backend folder)
# PROJECT_DISK_PATH=/media/srv/741C94C748D7C32A

# ── Services page ────────────────────────────────────────────────────
# systemd units the panel may start/stop (each also needs a sudoers rule)
# SERVICES=nginx,cloudflared,docker,ssh,ufw,cron

# ── Web terminal ─────────────────────────────────────────────────────
# TERMINAL_MAX_SESSIONS=6        # shells per user
# TERMINAL_DETACH_MINUTES=15     # keep a shell alive this long after disconnect
# TERMINAL_SHELL=/bin/bash
